---
import '../styles/global.css';
import fonteArchivo from '../assets/fontes/archivo-subset.woff2?url';
import Seo, { type SeoProps } from '../components/seo/Seo.astro';
import Cabecalho from '../components/layout/Cabecalho.astro';
import Rodape from '../components/layout/Rodape.astro';
import GavetaCarrinho from '../components/islands/GavetaCarrinho';
import WhatsAppFlutuante from '../components/islands/WhatsAppFlutuante';
import { mensagemContato, montarLinkWhatsApp } from '../lib/whatsapp';
import { site } from '../config/site';

type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={fonteArchivo} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={site.nome} />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#conteudo" class="pular-conteudo">
      Pular para o conteúdo
    </a>

    <Cabecalho />

    <main id="conteudo" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <Rodape />

    <aside aria-label="Atendimento pelo WhatsApp">
      <WhatsAppFlutuante client:idle link={montarLinkWhatsApp(mensagemContato)} />
    </aside>
    <GavetaCarrinho client:idle />
    <slot name="fim" />
  </body>
</html>

<style>
  .pular-conteudo {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    border-radius: var(--raio);
    font-weight: 800;
    background-color: var(--placa-amarela);
    color: var(--asfalto);
    text-decoration: none;
  }
  .pular-conteudo:focus {
    top: 0.75rem;
  }
</style>
