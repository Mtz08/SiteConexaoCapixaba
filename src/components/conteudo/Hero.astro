---
import Icone from '../icones/Icone.astro';
import { site } from '../../config/site';
import { mensagemContato, montarLinkWhatsApp } from '../../lib/whatsapp';

/**
 * Hero: estrada à noite em perspectiva (SVG leve), faróis suaves e o slogan enorme.
 * Sem imagem nem vídeo: o LCP é o próprio texto.
 */
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__estrada" aria-hidden="true">
    <svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMax slice" class="hero__svg">
      <defs>
        <linearGradient id="hero-asfalto" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#1a212c" />
          <stop offset="1" stop-color="#0f141b" />
        </linearGradient>
        <radialGradient id="hero-farol" cx="0.5" cy="1" r="0.75">
          <stop offset="0" stop-color="#f5e6b8" stop-opacity="0.22" />
          <stop offset="0.5" stop-color="#f5b700" stop-opacity="0.06" />
          <stop offset="1" stop-color="#f5b700" stop-opacity="0" />
        </radialGradient>
      </defs>
      <!-- serra no horizonte -->
      <path
        d="M0 330 L140 300 L260 318 L380 286 L520 312 L600 296 L700 310 L840 280 L980 306 L1100 290 L1200 302 L1200 340 L0 340 Z"
        fill="#141b25"
      ></path>
      <g class="hero__cena">
        <!-- pista em perspectiva -->
        <path d="M560 332 L640 332 L1200 700 L0 700 Z" fill="url(#hero-asfalto)"></path>
        <!-- acostamento (faixas laterais) -->
        <path d="M560 332 L566 332 L40 700 L0 700 Z" fill="#f2efe6" opacity="0.55"></path>
        <path d="M634 332 L640 332 L1200 700 L1160 700 Z" fill="#f2efe6" opacity="0.55"></path>
        <!-- faixa central tracejada -->
        <g class="hero__faixa" fill="#f5b700">
          <path d="M598 340 L602 340 L603.5 356 L596.5 356 Z"></path>
          <path d="M594.5 380 L605.5 380 L608 412 L592 412 Z"></path>
          <path d="M588 452 L612 452 L617 506 L583 506 Z"></path>
          <path d="M576 560 L624 560 L634 660 L566 660 Z"></path>
        </g>
        <!-- faróis -->
        <ellipse cx="600" cy="700" rx="620" ry="380" fill="url(#hero-farol)"></ellipse>
      </g>
    </svg>
  </div>

  <div class="hero__conteudo container-site">
    <p class="hero__selo">
      <Icone nome="mapa" tamanho={16} /> Direto do Espírito Santo
    </p>
    <h1 id="hero-titulo" class="hero__titulo">
      <span>Vivendo o</span>
      <span class="hero__destaque">extraordinário</span>
    </h1>
    <p class="hero__subtitulo">
      Camisas polo, camisetas, moletons, adesivos e bonés direto do Espírito Santo. Enviamos para todo o
      Brasil.
    </p>
    <div class="hero__acoes" data-esconde-flutuante>
      <a href="/loja" class="botao botao--primario botao--grande">
        Ver a loja
        <Icone nome="seta-direita" tamanho={20} />
      </a>
      <a
        href={montarLinkWhatsApp(mensagemContato)}
        class="botao botao--whatsapp botao--grande"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icone nome="whatsapp" tamanho={22} />
        Falar no WhatsApp
        <span class="sr-only">(abre em nova aba)</span>
      </a>
    </div>
    <p class="sr-only">
      {site.nome}: {site.slogan}.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: linear-gradient(180deg, #0d1117 0%, #121a26 52%, #0d1117 100%);
    display: grid;
    min-height: min(92svh, 52rem);
    overflow: hidden;
    border-bottom: 1px solid var(--faixa);
  }
  .hero__estrada {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__svg {
    width: 100%;
    height: 100%;
  }
  /* No desktop a estrada vai para a direita: a faixa central não passa sob o texto */
  @media (width >= 64rem) {
    .hero__cena {
      transform: translateX(260px);
    }
  }
  /* Faixa central "andando" na direção de quem olha */
  .hero__faixa {
    animation: faixa-anda 1.6s linear infinite;
    transform-origin: 600px 332px;
  }
  @keyframes faixa-anda {
    from {
      transform: scale(1);
      opacity: 1;
    }
    to {
      transform: scale(1.18);
      opacity: 0.85;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__faixa {
      animation: none;
    }
  }

  .hero__conteudo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding-block: 4rem 9rem;
  }
  @media (width >= 48rem) {
    .hero__conteudo {
      padding-block: 5rem 12rem;
    }
  }

  .hero__selo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--placa-branca);
    border-radius: 0.375rem;
    background-color: var(--placa-verde);
    color: #ffffff;
    font-stretch: 85%;
    font-weight: 800;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__titulo {
    display: flex;
    flex-direction: column;
    font-stretch: 62%;
    font-weight: 900;
    font-size: clamp(2.6rem, 0.4rem + 11vw, 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-shadow: 0 6px 40px rgb(0 0 0 / 0.6);
  }
  .hero__destaque {
    color: var(--placa-amarela);
  }

  .hero__subtitulo {
    max-width: 36rem;
    font-size: var(--text-lg);
    color: var(--texto);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.8);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  @media (width < 30rem) {
    .hero__acoes > * {
      flex: 1 1 100%;
    }
  }
</style>
