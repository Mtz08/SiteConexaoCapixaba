---
import Icone from '../icones/Icone.astro';
import { instagramUrl, site } from '../../config/site';

/** Chamada para o Instagram. Sem embed: nada é carregado do Instagram (privacidade e velocidade). */
---

<section class="instagram" aria-labelledby="instagram-titulo">
  <div class="instagram__placa">
    <Icone nome="instagram" tamanho={44} />
    <div class="instagram__texto">
      <h2 id="instagram-titulo" class="instagram__titulo">
        Acompanhe a estrada com a gente
      </h2>
      <p>Lançamentos, bastidores e a família Conexão Capixaba no Instagram.</p>
    </div>
    <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="botao botao--contorno-claro">
      @{site.instagram}
      <span class="sr-only">(Instagram, abre em nova aba)</span>
    </a>
  </div>
</section>

<style>
  .instagram__placa {
    position: relative;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding: 1.75rem 1.5rem;
    border-radius: var(--raio-placa);
    background-color: var(--placa-azul);
    color: #ffffff;
    box-shadow: var(--sombra-placa);
  }
  .instagram__placa::before {
    content: '';
    position: absolute;
    inset: 0.375rem;
    border: 2px solid #ffffff;
    border-radius: calc(var(--raio-placa) - 0.3rem);
    pointer-events: none;
  }
  @media (width >= 48rem) {
    .instagram__placa {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1.5rem;
      padding: 2rem 2.25rem;
    }
  }
  .instagram__texto {
    display: grid;
    gap: 0.375rem;
  }
  .instagram__titulo {
    font-size: var(--text-3xl);
  }
  .botao--contorno-claro {
    position: relative;
    border-color: #ffffff;
    color: #ffffff;
    text-transform: none;
  }
  .botao--contorno-claro:hover {
    background-color: #ffffff;
    color: var(--placa-azul);
  }
</style>
