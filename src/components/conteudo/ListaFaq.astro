---
import type { PerguntaFrequente } from '../../data/faq';

/** Acordeão acessível com <details>/<summary> (funciona sem JavaScript). */
interface Props {
  perguntas: PerguntaFrequente[];
  /** Nível do título de cada pergunta dentro do <summary>. */
  nivel?: 'h2' | 'h3';
}

const { perguntas, nivel = 'h3' } = Astro.props;
const Titulo = nivel;
---

<div class="faq">
  {perguntas.map((p) => (
    <details class="faq__item" id={p.id}>
      <summary class="faq__pergunta">
        <Titulo class="faq__titulo">{p.pergunta}</Titulo>
        <span class="faq__sinal" aria-hidden="true" />
      </summary>
      <div class="faq__resposta">
        {p.resposta.map((paragrafo) => (
          <p>{paragrafo}</p>
        ))}
        {p.link && (
          <a href={p.link.href} class="faq__link">
            {p.link.rotulo}
          </a>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
    border-top: 1px solid var(--faixa);
  }
  .faq__item {
    border-bottom: 1px solid var(--faixa);
  }
  .faq__pergunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.875rem;
    cursor: pointer;
    list-style: none;
  }
  .faq__pergunta::-webkit-details-marker {
    display: none;
  }
  .faq__titulo {
    font-stretch: 85%;
    font-weight: 750;
    font-size: var(--text-lg);
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }
  .faq__pergunta:hover .faq__titulo {
    color: var(--placa-amarela);
  }
  /* Sinal de + que vira − (placa de cruzamento) */
  .faq__sinal {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid var(--placa-amarela);
    border-radius: 0.3rem;
  }
  .faq__sinal::before,
  .faq__sinal::after {
    content: '';
    position: absolute;
    inset: 50% 25% auto;
    height: 2px;
    margin-top: -1px;
    background-color: var(--placa-amarela);
    transition: transform 0.2s;
  }
  .faq__sinal::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__sinal::after {
    transform: rotate(0deg);
  }
  .faq__resposta {
    display: grid;
    gap: 0.75rem;
    max-width: 65ch;
    padding-bottom: 1.25rem;
    color: var(--texto-mudo);
  }
  .faq__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--texto);
    font-weight: 600;
  }
</style>
